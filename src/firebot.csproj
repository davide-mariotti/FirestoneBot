<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>Firebot</RootNamespace>
        <AssemblyName>firebot</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- TalentEngine is its own project (no game references, unit tested): keep this project's
             default **/*.cs glob from compiling its files a second time. -->
        <Compile Remove="TalentEngine\**\*.cs" />
        <ProjectReference Include="TalentEngine\Firebot.TalentEngine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="MelonLoader">
            <HintPath>$(MelonLoaderNetDir)\MelonLoader.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(MelonLoaderNetDir)\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppInterop.Runtime">
            <HintPath>$(MelonLoaderNetDir)\Il2CppInterop.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(Il2CppAssembliesDir)\Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppACTk.Runtime">
            <HintPath>$(Il2CppAssembliesDir)\Il2CppACTk.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(Il2CppAssembliesDir)\Il2Cppmscorlib.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(Il2CppAssembliesDir)\Unity.TextMeshPro.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.PhysicsModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.TextRenderingModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UIModule.dll</HintPath>
        </Reference>
        <Reference Include="Il2CppCoreASM">
            <HintPath>$(Il2CppAssembliesDir)\Il2CppCoreASM.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
